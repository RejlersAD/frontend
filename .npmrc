# NPM Configuration for consistent dependency resolution
# Prevents module cache issues when pulling code from different developers

# Use exact versions (no fuzzy matching)
save-exact=false

# Prefer offline mode to use local cache first
prefer-offline=true

# Strict peer dependencies
legacy-peer-deps=false

# Engine strict mode
engine-strict=false

# Consistent lockfile format
lockfile-version=3

# Cache optimization
cache-min=86400
