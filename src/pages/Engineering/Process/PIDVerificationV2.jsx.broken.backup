import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { API_BASE_URL } from '../../../config/api.config';
import {
  Upload, FileText, AlertCircle, CheckCircle, Clock, Database,
  Search, Filter, Download, Eye, XCircle, Loader, Cpu, Zap, Network, Sparkles
} from 'lucide-react';

/**
 * P&ID Checker V2 — AI-Powered Multi-Document Validation Engine
 * 
 * Backend Integration:
 * - API: /api/v2/pid-checker/
 * - Database: pidv2_* tables  
 * - Queue: pidv2_extraction
 * - AI: OpenAI GPT-4.1 Vision + Claude Sonnet 3.5
 */

// Build V2 API URL by replacing v1 with v2/pid-checker in the base URL
// API_BASE_URL is '/api/v1' for local, so we replace to get '/api/v2/pid-checker'
const API_V2_PREFIX = API_BASE_URL.replace(/\/api\/v1/, '/api/v2/pid-checker');

// Theme configuration (matching V1)
const KEYFRAMES = `
  @keyframes fadeUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
  @keyframes gradShift { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }
  @keyframes pulse2 { 0%,100%{opacity:1} 50%{opacity:0.4} }
  @keyframes shimmer { 0%{background-position:-200% 0} 100%{background-position:200% 0} }
  @keyframes floatA { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(40px,-30px) scale(1.06)} }
  @keyframes floatB { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-35px,25px) scale(1.04)} }
  @keyframes floatC { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(20px,35px) scale(1.05)} }
`;

const THEME = {
  bg: 'linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%)',
  blobs: [
    { size:'400px', top:'5%', left:'-5%', color:'rgba(99,102,241,0.08)', anim:'floatA 25s ease-in-out infinite' },
    { size:'350px', bottom:'10%', right:'-8%', color:'rgba(59,130,246,0.08)', anim:'floatB 22s ease-in-out infinite' },
    { size:'300px', top:'40%', right:'15%', color:'rgba(147,51,234,0.06)', anim:'floatC 28s ease-in-out infinite' },
  ],
  card: {
    background: 'linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.92) 100%)',
    backdropFilter: 'blur(10px)',
    border: '1px solid rgba(99,102,241,0.15)',
  },
};

// Soft-coded constants
const MAX_FILE_SIZE_MB = 50;
const POLLING_INTERVAL_MS = 3000;
const SEVERITY_COLORS = {
  CRITICAL: 'bg-red-100 text-red-800 border-red-300',
  HIGH: 'bg-orange-100 text-orange-800 border-orange-300',
  MEDIUM: 'bg-yellow-100 text-yellow-800 border-yellow-300',
  LOW: 'bg-blue-100 text-blue-800 border-blue-300',
  INFO: 'bg-gray-100 text-gray-800 border-gray-300'
};

// Document type options
const DOCUMENT_TYPES = [
  { value: 'PID', label: 'P&ID Drawing', icon: '📐' },
  { value: 'LEGENDS', label: 'P&ID Legends', icon: '📋' },
  { value: 'EQUIPMENT_LIST', label: 'Equipment List', icon: '⚙️' },
  { value: 'LINE_LIST', label: 'Line List', icon: '🔗' },
  { value: 'INSTRUMENT_INDEX', label: 'Instrument Index', icon: '🎚️' },
  { value: 'VALVE_LIST', label: 'Valve List', icon: '🚰' },
  { value: 'UNKNOWN', label: 'Unknown / Other', icon: '❓' }
];

const PIDVerificationV2 = () => {
  // State management
  const [projects, setProjects] = useState([]);
  const [currentProject, setCurrentProject] = useState(null);
  const [selectedDocuments, setSelectedDocuments] = useState([]); // Array of {file: File, documentType: string}
  const [projectName, setProjectName] = useState('');
  const [projectDescription, setProjectDescription] = useState('');
  const [uploading, setUploading] = useState(false);
  const [findings, setFindings] = useState([]);
  const [filteredFindings, setFilteredFindings] = useState([]);
  const [statistics, setStatistics] = useState(null);
  const [activeTab, setActiveTab] = useState('upload'); // upload, projects, findings
  const [severityFilter, setSeverityFilter] = useState('all');
  const [statusFilter, setStatusFilter] = useState('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedFinding, setSelectedFinding] = useState(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [authError, setAuthError] = useState(null);
  
  // Auth header - compatible with multiple token storage keys
  const authHeader = () => {
    const token = localStorage.getItem('access_token') || 
                  localStorage.getItem('radai_access_token') || 
                  localStorage.getItem('access');
    return token ? { Authorization: `Bearer ${token}` } : {};
  };
  
  // Check authentication status
  const checkAuth = () => {
    const token = localStorage.getItem('access_token') || 
                  localStorage.getItem('radai_access_token') || 
                  localStorage.getItem('access');
    const authenticated = !!token;
    setIsAuthenticated(authenticated);
    
    if (!authenticated) {
      setAuthError('Please log in to access P&ID Checker V2');
    } else {
      setAuthError(null);
    }
    
    return authenticated;
  };
  
  // Check auth on mount
  useEffect(() => {
    const authenticated = checkAuth();
    if (authenticated) {
      loadProjects();
    }
  }, []);
  
  // Poll extraction status
  useEffect(() => {
    let interval;
    if (currentProject && ['pending', 'processing'].includes(currentProject.extraction_status)) {
      interval = setInterval(() => {
        refreshProjectStatus();
      }, POLLING_INTERVAL_MS);
    }
    return () => clearInterval(interval);
  }, [currentProject]);
  
  // Filter findings
  useEffect(() => {
    applyFilters();
  }, [findings, severityFilter, statusFilter, searchQuery]);
  
  // API Functions
  const loadProjects = async () => {
    if (!checkAuth()) return;
    
    try {
      const response = await axios.get(`${API_V2_PREFIX}/projects/`, {
        headers: authHeader()
      });
      
      // Handle both paginated ({results: []}) and non-paginated ([]) responses
      const projectsData = Array.isArray(response.data) 
        ? response.data 
        : (response.data.results || []);
      
      setProjects(projectsData);
      setAuthError(null);
    } catch (error) {
      console.error('Failed to load projects:', error);
      if (error.response?.status === 401) {
        setAuthError('Your session has expired. Please log in again.');
        setIsAuthenticated(false);
      }
      // Ensure projects is always an array even on error
      setProjects([]);
    }
  };
  
  const refreshProjectStatus = async () => {
    if (!currentProject) return;
    
    try {
      const response = await axios.get(
        `${API_V2_PREFIX}/projects/${currentProject.id}/`,
        { headers: authHeader() }
      );
      setCurrentProject(response.data);
      setStatistics(response.data.statistics);
      
      if (response.data.extraction_status === 'completed') {
        loadFindings();
      }
    } catch (error) {
      console.error('Failed to refresh project status:', error);
    }
  };
  
  const handleUpload = async () => {
    if (!checkAuth()) {
      alert('Please log in to upload documents.');
      return;
    }
    
    if (selectedDocuments.length === 0 || !projectName.trim()) {
      alert('Please provide a project name and select at least one file.');
      return;
    }
    
    // Validate that all documents have a type selected
    const hasUnknown = selectedDocuments.some(doc => doc.documentType === 'UNKNOWN');
    if (hasUnknown) {
      const proceed = window.confirm('Some documents have type "Unknown". Do you want to proceed anyway?');
      if (!proceed) return;
    }
    
    setUploading(true);
    
    try {
      const formData = new FormData();
      formData.append('name', projectName);
      formData.append('description', projectDescription);
      
      // Append files and their types
      selectedDocuments.forEach(doc => {
        formData.append('documents', doc.file);
      });
      
      // Send document types as JSON array
      const documentTypes = selectedDocuments.map(doc => doc.documentType);
      formData.append('document_types', JSON.stringify(documentTypes));
      
      const response = await axios.post(
        `${API_V2_PREFIX}/projects/`,
        formData,
        {
          headers: {
            ...authHeader(),
            'Content-Type': 'multipart/form-data'
          }
        }
      );
      
      setCurrentProject(response.data);
      setProjectName('');
      setProjectDescription('');
      setSelectedDocuments([]);
      setActiveTab('findings');
      loadProjects();
    } catch (error) {
      console.error('Upload failed:', error);
      if (error.response?.status === 401) {
        alert('Your session has expired. Please log in again.');
        setAuthError('Your session has expired. Please log in again.');
        setIsAuthenticated(false);
      } else {
        alert(`Upload failed: ${error.response?.data?.error || error.message}`);
      }
    } finally {
      setUploading(false);
    }
  };
  
  const loadProjectDetails = async (projectId) => {
    try {
      const [projectRes, findingsRes] = await Promise.all([
        axios.get(`${API_V2_PREFIX}/projects/${projectId}/`, {
          headers: authHeader()
        }),
        axios.get(`${API_V2_PREFIX}/projects/${projectId}/findings/`, {
          headers: authHeader()
        })
      ]);
      
      setCurrentProject(projectRes.data);
      setStatistics(projectRes.data.statistics || null);
      
      // Handle both paginated and non-paginated findings responses
      const findingsData = Array.isArray(findingsRes.data)
        ? findingsRes.data
        : (findingsRes.data.results || []);
      setFindings(findingsData);
      
      setActiveTab('findings');
    } catch (error) {
      console.error('Failed to load project details:', error);
      setFindings([]);
    }
  };
  
  const loadFindings = async () => {
    if (!currentProject) return;
    
    try {
      const response = await axios.get(
        `${API_V2_PREFIX}/projects/${currentProject.id}/findings/`,
        { headers: authHeader() }
      );
      
      // Handle both paginated and non-paginated responses
      const findingsData = Array.isArray(response.data)
        ? response.data
        : (response.data.results || []);
      setFindings(findingsData);
    } catch (error) {
      console.error('Failed to load findings:', error);
      setFindings([]);
    }
  };
  
  const applyFilters = () => {
    // Safety check: ensure findings is an array
    const findingsList = Array.isArray(findings) ? findings : [];
    let filtered = [...findingsList];
    
    if (severityFilter !== 'all') {
      filtered = filtered.filter(f => f.severity === severityFilter);
    }
    
    if (statusFilter !== 'all') {
      filtered = filtered.filter(f => f.status === statusFilter);
    }
    
    if (searchQuery) {
      filtered = filtered.filter(f =>
        f.finding_id?.toLowerCase().includes(searchQuery.toLowerCase()) ||
        f.affected_tag?.toLowerCase().includes(searchQuery.toLowerCase()) ||
        f.description?.toLowerCase().includes(searchQuery.toLowerCase())
      );
    }
    
    setFilteredFindings(filtered);
  };
  
  const handleFileSelect = (e) => {
    const files = Array.from(e.target.files);
    const oversized = files.filter(f => f.size > MAX_FILE_SIZE_MB * 1024 * 1024);
    
    if (oversized.length > 0) {
      alert(`Some files exceed ${MAX_FILE_SIZE_MB}MB limit and were not added.`);
      return;
    }
    
    // Convert files to document objects with auto-detected types
    const newDocuments = files.map(file => ({
      file,
      documentType: autoDetectDocumentType(file.name)
    }));
    
    setSelectedDocuments(prev => [...prev, ...newDocuments]);
  };
  
  const autoDetectDocumentType = (filename) => {
    const lower = filename.toLowerCase();
    if (lower.includes('legend')) return 'LEGENDS';
    if (lower.includes('equipment') || lower.includes('eq')) return 'EQUIPMENT_LIST';
    if (lower.includes('line') && lower.includes('list')) return 'LINE_LIST';
    if (lower.includes('instrument') || lower.includes('index')) return 'INSTRUMENT_INDEX';
    if (lower.includes('valve')) return 'VALVE_LIST';
    if (lower.includes('pid') || lower.includes('p&id')) return 'PID';
    return 'UNKNOWN';
  };
  
  const updateDocumentType = (index, newType) => {
    setSelectedDocuments(prev => prev.map((doc, i) => 
      i === index ? { ...doc, documentType: newType } : doc
    ));
  };
  
  const removeDocument = (index) => {
    setSelectedDocuments(prev => prev.filter((_, i) => i !== index));
  };
  
  // Render Functions
  const renderUploadTab = () => (
    <div className="rounded-2xl overflow-hidden border border-indigo-200/30" style={THEME.card}>
      <div className="bg-gradient-to-r from-indigo-50 to-blue-50 px-6 py-4 border-b border-indigo-100/40">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-lg flex items-center justify-center"
            style={{ background: 'linear-gradient(135deg,#6366f1,#3b82f6)', boxShadow: '0 4px 12px rgba(99,102,241,0.35)' }}>
            <Upload className="w-5 h-5 text-white" />
          </div>
          <div>
            <h2 className="text-xl font-bold text-slate-900">Create New Project</h2>
            <p className="text-sm text-slate-600">Upload P&ID drawings and supporting documents for AI-powered validation</p>
          </div>
        </div>
      </div>
      <div className="p-6">
      
      <div className="space-y-4">
        <div>
          <label className="block text-sm font-semibold text-slate-700 mb-2">Project Name *</label>
          <input
            type="text"
            value={projectName}
            onChange={(e) => setProjectName(e.target.value)}
            className="w-full px-4 py-2.5 border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
            placeholder="e.g., Project XYZ - P&ID Package"
          />
        </div>
        
        <div>
          <label className="block text-sm font-semibold text-slate-700 mb-2">Description</label>
          <textarea
            value={projectDescription}
            onChange={(e) => setProjectDescription(e.target.value)}
            rows={3}
            className="w-full px-4 py-2.5 border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all resize-none"
            placeholder="Optional project description"
          />
        </div>
        
        <div>
          <label className="block text-sm font-semibold text-slate-700 mb-2">Documents *</label>
          <div className="border-2 border-dashed border-indigo-200 rounded-xl p-8 text-center hover:border-indigo-400 hover:bg-indigo-50/30 transition-all cursor-pointer">
            <input
              type="file"
              multiple
              accept=".pdf,.png,.jpg,.jpeg,.xlsx,.xls"
              onChange={handleFileSelect}
              className="hidden"
              id="file-upload"
            />
            <label htmlFor="file-upload" className="cursor-pointer">
              <div className="w-16 h-16 rounded-full mx-auto mb-3 flex items-center justify-center"
                style={{ background: 'linear-gradient(135deg,#6366f1,#3b82f6)', boxShadow: '0 4px 14px rgba(99,102,241,0.4)' }}>
                <Upload className="w-8 h-8 text-white" />
              </div>
              <p className="text-slate-700 font-semibold mb-1">Click to upload or drag and drop</p>
              <p className="text-sm text-slate-600">Select document type for each file after upload</p>
              <p className="text-xs text-slate-500 mt-2">Supports: P&ID, Legends, Equipment List, Line List, Instrument Index</p>
              <p className="text-xs text-slate-500">Max {MAX_FILE_SIZE_MB}MB per file • PDF, Excel, Images</p>
            </label>
          </div>
        </div>
        
        {selectedDocuments.length > 0 && (
          <div className="space-y-3">
            <p className="text-sm font-semibold text-slate-700">
              Selected Files ({selectedDocuments.length})
            </p>
            {selectedDocuments.map((doc, index) => (
              <div key={index} className="flex items-center gap-3 bg-gradient-to-r from-indigo-50/50 to-blue-50/30 px-4 py-3 rounded-xl border border-indigo-200/60 hover:border-indigo-300 transition-all">
                <div className="flex-shrink-0">
                  <FileText className="w-5 h-5 text-blue-500" />
                </div>
                
                <div className="flex-1 min-w-0">
                  <p className="text-sm font-semibold text-slate-900 truncate">{doc.file.name}</p>
                  <p className="text-xs text-slate-500">{(doc.file.size / 1024 / 1024).toFixed(2)} MB</p>
                </div>
                
                <div className="flex-shrink-0 w-64">
                  <select
                    value={doc.documentType}
                    onChange={(e) => updateDocumentType(index, e.target.value)}
                    className="w-full px-3 py-2 text-sm border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all bg-white"
                  >
                    {DOCUMENT_TYPES.map(type => (
                      <option key={type.value} value={type.value}>
                        {type.icon} {type.label}
                      </option>
                    ))}
                  </select>
                </div>
                
                <button
                  onClick={() => removeDocument(index)}
                  className="flex-shrink-0 text-red-500 hover:text-red-700 transition"
                  title="Remove file"
                >
                  <XCircle className="w-5 h-5" />
                </button>
              </div>
            ))}
          </div>
        )}
        
        <button
          onClick={handleUpload}
          disabled={uploading || selectedDocuments.length === 0 || !projectName.trim()}
          className="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition flex items-center justify-center space-x-2"
        >
          {uploading ? (
            <>
              <Loader className="w-5 h-5 animate-spin" />
              <span>Uploading...</span>
            </>
          ) : (
            <>
              <Upload className="w-5 h-5" />
              <span>Create Project & Start Processing</span>
            </>
          )}
        </button>
      </div>
    </div>
  );
  
  const renderProjectsTab = () => {
    // Safety check: ensure projects is always an array
    const projectList = Array.isArray(projects) ? projects : [];
    
    return (
      <div className="rounded-2xl overflow-hidden border border-indigo-200/30" style={THEME.card}>
        <div className="bg-gradient-to-r from-indigo-50 to-blue-50 px-6 py-4 border-b border-indigo-100/40">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg flex items-center justify-center"
              style={{ background: 'linear-gradient(135deg,#6366f1,#3b82f6)', boxShadow: '0 4px 12px rgba(99,102,241,0.35)' }}>
              <Database className="w-5 h-5 text-white" />
            </div>
            <h2 className="text-xl font-bold text-slate-900">All Projects</h2>
          </div>
        </div>
        
        <div className="p-6">
          {projectList.length === 0 ? (
            <div className="text-center py-16">
              <div className="w-20 h-20 rounded-full mx-auto mb-4 flex items-center justify-center"
                style={{ background: 'linear-gradient(135deg,#e0e7ff,#dbeafe)' }}>
                <Database className="w-10 h-10 text-indigo-400" />
              </div>
              <p className="text-slate-600 font-medium">No projects yet. Create your first project above.</p>
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {projectList.map(project => (
              <div
                key={project.id}
                onClick={() => loadProjectDetails(project.id)}
                className="border border-indigo-200/60 rounded-xl p-4 bg-gradient-to-br from-white to-indigo-50/30 hover:border-indigo-400 hover:shadow-lg hover:scale-[1.02] transition-all cursor-pointer"
              >
                <div className="flex items-start justify-between mb-2">
                  <h3 className="font-bold text-slate-900">{project.name}</h3>
                  {project.extraction_status === 'completed' && <CheckCircle className="w-5 h-5 text-emerald-500" />}
                  {project.extraction_status === 'processing' && <Clock className="w-5 h-5 text-amber-500 animate-pulse" />}
                  {project.extraction_status === 'failed' && <XCircle className="w-5 h-5 text-red-500" />}
                </div>
                
                <p className="text-sm text-slate-600 mb-3">{project.description || 'No description'}</p>
                
                <div className="flex items-center justify-between text-xs text-slate-500 font-medium">
                  <span>{project.document_count || 0} documents</span>
                  <span>{project.finding_count || 0} findings</span>
              </div>
              
              <div className="mt-2 text-xs text-gray-400">
                {new Date(project.created_at).toLocaleDateString()}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
    </div>
  );
};
  
  const renderFindingsTab = () => (
    <div className="rounded-2xl overflow-hidden border border-indigo-200/30" style={THEME.card}>
      <div className="bg-gradient-to-r from-indigo-50 to-blue-50 px-6 py-4 border-b border-indigo-100/40">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-lg flex items-center justify-center"
            style={{ background: 'linear-gradient(135deg,#6366f1,#3b82f6)', boxShadow: '0 4px 12px rgba(99,102,241,0.35)' }}>
            <AlertCircle className="w-5 h-5 text-white" />
          </div>
          <h2 className="text-xl font-bold text-slate-900">Validation Findings</h2>
        </div>
      </div>
      
      <div className="p-6">
        <div className="flex flex-wrap gap-4 mb-6">
          <div>
            <label className="block text-sm font-semibold text-slate-700 mb-1">Severity</label>
            <select
              value={severityFilter}
              onChange={(e) => setSeverityFilter(e.target.value)}
              className="px-4 py-2 border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all bg-white"
            >
              <option value="all">All Severities</option>
              <option value="CRITICAL">Critical</option>
              <option value="HIGH">High</option>
              <option value="MEDIUM">Medium</option>
              <option value="LOW">Low</option>
            </select>
          </div>
          
          <div>
            <label className="block text-sm font-semibold text-slate-700 mb-1">Status</label>
            <select
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
              className="px-4 py-2 border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all bg-white"
            >
              <option value="all">All Status</option>
              <option value="open">Open</option>
              <option value="resolved">Resolved</option>
            </select>
          </div>
          
          <div className="flex-1">
            <label className="block text-sm font-medium text-gray-700 mb-1">Search</label>
            <div className="relative">
              <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" />
              <input
                type="text"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="Search findings, tags..."
                className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>
        </div>
        
        {statistics && (
          <div className="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
            <div className="bg-red-50 border border-red-200 rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-red-700">{statistics.findings?.by_severity?.CRITICAL || 0}</div>
              <div className="text-xs text-red-600">Critical</div>
            </div>
            <div className="bg-orange-50 border border-orange-200 rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-orange-700">{statistics.findings?.by_severity?.HIGH || 0}</div>
              <div className="text-xs text-orange-600">High</div>
            </div>
            <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-yellow-700">{statistics.findings?.by_severity?.MEDIUM || 0}</div>
              <div className="text-xs text-yellow-600">Medium</div>
            </div>
            <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-blue-700">{statistics.findings?.by_severity?.LOW || 0}</div>
              <div className="text-xs text-blue-600">Low</div>
            </div>
            <div className="bg-green-50 border border-green-200 rounded-lg p-3 text-center">
              <div className="text-2xl font-bold text-green-700">{statistics.findings?.resolved || 0}</div>
              <div className="text-xs text-green-600">Resolved</div>
            </div>
          </div>
        )}
      </div>
      
      <div className="overflow-x-auto">
        <table className="w-full">
          <thead className="bg-gray-50 border-b border-gray-200">
            <tr>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Finding ID</th>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Severity</th>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tag</th>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-gray-200">
            {filteredFindings.map(finding => (
              <tr key={finding.id} className="hover:bg-gray-50">
                <td className="px-4 py-3 text-sm font-mono text-gray-900">{finding.finding_id}</td>
                <td className="px-4 py-3">
                  <span className={`px-2 py-1 text-xs font-semibold rounded-full border ${SEVERITY_COLORS[finding.severity]}`}>
                    {finding.severity}
                  </span>
                </td>
                <td className="px-4 py-3 text-sm text-gray-600">{finding.category?.replace(/_/g, ' ')}</td>
                <td className="px-4 py-3 text-sm font-mono text-blue-600">{finding.affected_tag || 'N/A'}</td>
                <td className="px-4 py-3 text-sm text-gray-900 max-w-md truncate">{finding.description}</td>
                <td className="px-4 py-3">
                  <span className={`px-2 py-1 text-xs rounded-full ${finding.status === 'resolved' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}`}>
                    {finding.status}
                  </span>
                </td>
                <td className="px-4 py-3">
                  <button
                    onClick={() => setSelectedFinding(finding)}
                    className="text-blue-600 hover:text-blue-800 text-sm font-medium"
                  >
                    <Eye className="w-4 h-4" />
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      
      {filteredFindings.length === 0 && (
        <div className="text-center py-12">
          <AlertCircle className="w-16 h-16 mx-auto text-gray-400 mb-4" />
          <p className="text-gray-600">No findings match your filters</p>
        </div>
      )}
    </div>
  );
  
  return (
    <div className="min-h-screen relative overflow-hidden" style={{ background: THEME.bg }}>
      <style>{KEYFRAMES}</style>
      
      {/* Animated background pattern */}
      <div className="absolute inset-0 pointer-events-none"
        style={{ backgroundImage:'radial-gradient(circle, rgba(99,102,241,0.055) 1px, transparent 1px)', backgroundSize:'40px 40px' }} />
      
      {/* Floating gradient blobs */}
      {THEME.blobs.map((b, i) => (
        <div key={i} className="absolute rounded-full pointer-events-none"
          style={{ width:b.size, height:b.size, top:b.top, bottom:b.bottom, left:b.left, right:b.right,
            background:`radial-gradient(circle, ${b.color} 0%, transparent 70%)`, animation:b.anim }} />
      ))}
      
      {/* Top gradient line */}
      <div className="absolute inset-x-0 top-0 h-1 pointer-events-none"
        style={{ background:'linear-gradient(90deg,#3b82f6,#6366f1,#f59e0b,#3b82f6)', backgroundSize:'200% auto', animation:'gradShift 4s linear infinite' }} />
      
      {/* Main content */}
      <div className="relative z-10 p-6">
        <div className="max-w-7xl mx-auto">
          {/* Header */}
          <div className="mb-6" style={{ animation: 'fadeUp 0.4s ease-out' }}>
            <div className="flex items-center gap-3 mb-2">
              <div className="w-12 h-12 rounded-xl flex items-center justify-center"
                style={{ background: 'linear-gradient(135deg,#6366f1,#3b82f6)', boxShadow: '0 4px 14px rgba(99,102,241,0.4)' }}>
                <Sparkles className="w-6 h-6 text-white" />
              </div>
              <div>
                <h1 className="text-3xl font-bold text-white">P&ID Checker V2</h1>
                <p className="text-indigo-200 text-sm">AI-Powered Multi-Document Validation Engine</p>
              </div>
            </div>
          </div>
          
          {/* Auth error banner */}
          {authError && (
            <div className="mb-6 rounded-xl overflow-hidden border border-yellow-400/30" 
              style={{ ...THEME.card, animation: 'fadeUp 0.5s ease-out' }}>
              <div className="bg-gradient-to-r from-yellow-50 to-amber-50 p-4">
                <div className="flex items-center gap-3">
                  <AlertCircle className="w-5 h-5 text-yellow-600 flex-shrink-0" />
                  <div>
                    <p className="text-sm font-semibold text-yellow-900">{authError}</p>
                    <p className="text-sm text-yellow-700 mt-1">
                      Please <a href="/login" className="underline font-bold hover:text-yellow-900 transition">log in</a> to access this feature.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          )}
          
          {/* Tab Navigation */}
          <div className="mb-6 rounded-xl overflow-hidden border border-indigo-200/30"
            style={{ ...THEME.card, animation: 'fadeUp 0.6s ease-out' }}>
            <div className="flex border-b border-indigo-100/40">
              {['upload', 'projects', 'findings'].map(tab => (
                <button
                  key={tab}
                  onClick={() => setActiveTab(tab)}
                  disabled={!isAuthenticated}
                  className={`flex-1 px-6 py-3.5 font-semibold capitalize transition-all duration-200 relative ${
                    activeTab === tab
                      ? 'text-indigo-700 bg-gradient-to-r from-indigo-50 to-blue-50'
                      : 'text-slate-600 hover:bg-slate-50/50 hover:text-slate-900'
                  } ${!isAuthenticated ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}`}
                >
                  {tab}
                  {activeTab === tab && (
                    <div className="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-indigo-500 to-blue-500"
                      style={{ animation: 'shimmer 2s linear infinite', backgroundSize: '200% auto' }} />
                  )}
                </button>
              ))}
            </div>
          </div>
          
          {/* Tab Content */}
          {isAuthenticated ? (
            <div style={{ animation: 'fadeUp 0.7s ease-out' }}>
              {activeTab === 'upload' && renderUploadTab()}
              {activeTab === 'projects' && renderProjectsTab()}
              {activeTab === 'findings' && renderFindingsTab()}
            </div>
          ) : (
            <div className="rounded-2xl overflow-hidden border border-indigo-200/30" 
              style={{ ...THEME.card, animation: 'fadeUp 0.7s ease-out' }}>
              <div className="p-12 text-center">
                <div className="w-20 h-20 rounded-full mx-auto mb-6 flex items-center justify-center"
                  style={{ background: 'linear-gradient(135deg,#f59e0b,#f97316)', boxShadow: '0 8px 24px rgba(245,158,11,0.35)' }}>
                  <AlertCircle className="w-10 h-10 text-white" />
                </div>
                <h2 className="text-2xl font-bold text-slate-800 mb-2">Authentication Required</h2>
                <p className="text-slate-600 mb-6 max-w-md mx-auto">
                  You must be logged in to use the P&ID Checker V2.
                </p>
                <a
                  href="/login"
                  className="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-white transition-all hover:scale-105"
                  style={{ background: 'linear-gradient(135deg,#6366f1,#3b82f6)', boxShadow: '0 4px 14px rgba(99,102,241,0.4)' }}
                >
                  Go to Login
                </a>
              </div>
            </div>
          )}
          
          {/* Finding Detail Modal */}
          {selectedFinding && (
            <div className="fixed inset-0 flex items-center justify-center p-4 z-50"
              style={{ background: 'rgba(15,23,42,0.6)', backdropFilter: 'blur(8px)' }}>
              <div className="rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6"
                style={{ ...THEME.card, animation: 'fadeUp 0.3s ease-out' }}>
                <div className="flex items-start justify-between mb-4">
                  <div>
                    <h3 className="text-xl font-bold text-slate-900">{selectedFinding.finding_id}</h3>
                    <span className={`inline-block mt-2 px-3 py-1 text-sm font-semibold rounded-full border ${SEVERITY_COLORS[selectedFinding.severity]}`}>
                      {selectedFinding.severity}
                    </span>
                  </div>
                  <button
                    onClick={() => setSelectedFinding(null)}
                    className="p-2 hover:bg-slate-100 rounded-lg transition-colors"
                  >
                    <XCircle className="w-6 h-6 text-slate-400" />
                  </button>
                </div>
                
                <div className="space-y-4">
                  <div>
                    <label className="text-sm font-medium text-slate-700">Category</label>
                    <p className="text-slate-900 font-semibold">{selectedFinding.category?.replace(/_/g, ' ')}</p>
                  </div>
                  
                  {selectedFinding.affected_tag && (
                    <div>
                      <label className="text-sm font-medium text-slate-700">Affected Tag</label>
                      <p className="text-slate-900 font-mono bg-slate-50 px-3 py-2 rounded-lg">{selectedFinding.affected_tag}</p>
                    </div>
                  )}
                  
                  <div>
                  <label className="text-sm font-medium text-gray-700">Description</label>
                  <p className="text-gray-900">{selectedFinding.description}</p>
                </div>
                
                {selectedFinding.ai_reasoning && (
                  <div>
                    <label className="text-sm font-medium text-gray-700">AI Reasoning</label>
                    <p className="text-gray-700 text-sm bg-blue-50 p-3 rounded-lg">{selectedFinding.ai_reasoning}</p>
                  </div>
                )}
                
                {selectedFinding.suggested_fix && (
                  <div>
                    <label className="text-sm font-medium text-gray-700">Suggested Fix</label>
                    <p className="text-gray-700 text-sm bg-green-50 p-3 rounded-lg">{selectedFinding.suggested_fix}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
    </div>
  );
};

export default PIDVerificationV2;
