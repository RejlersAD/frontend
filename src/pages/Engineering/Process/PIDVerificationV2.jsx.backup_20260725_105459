import React, { useState, useCallback, useRef, useEffect } from 'react';
import axios from 'axios';
import { API_BASE_URL } from '../../../config/api.config';
import {
  Upload as UploadIcon, FileText, CheckCircle, AlertTriangle,
  Loader, X, Download, ChevronLeft, ChevronRight, ZoomIn, ZoomOut,
  RotateCw, RefreshCw, AlertCircle, Filter, Search, Eye, EyeOff,
} from 'lucide-react';

// ╔════════════════════════════════════════════════════════════════════════════╗
// ║                    🚀 P&ID VERIFICATION V2 (CLEAN)                         ║
// ║          Redesigned from scratch - Minimal & focused approach              ║
// ╚════════════════════════════════════════════════════════════════════════════╝

const API_PREFIX = `${API_BASE_URL}/pid-verification`;

// ── Soft-Coded Configuration ──────────────────────────────────────────────────
const DEFAULT_ZOOM_LEVEL = 1.0;
const ZOOM_STEP = 0.1;
const MIN_ZOOM = 0.5;
const MAX_ZOOM = 3.0;
const HIDDEN_SEVERITIES = new Set(['info']); // Hide info-level findings

// ── Helper Functions ──────────────────────────────────────────────────────────
const authHeader = () => {
  const token = localStorage.getItem('access_token');
  return token ? { Authorization: `Bearer ${token}` } : {};
};

const getSeverityBadge = (severity) => {
  const configs = {
    critical: { bg: 'bg-red-100', text: 'text-red-800', icon: AlertCircle },
    high: { bg: 'bg-orange-100', text: 'text-orange-800', icon: AlertTriangle },
    medium: { bg: 'bg-yellow-100', text: 'text-yellow-800', icon: AlertTriangle },
    low: { bg: 'bg-blue-100', text: 'text-blue-800', icon: AlertTriangle },
    info: { bg: 'bg-gray-100', text: 'text-gray-800', icon: CheckCircle },
  };
  const cfg = configs[severity] || configs.info;
  const Icon = cfg.icon;
  return (
    <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium ${cfg.bg} ${cfg.text}`}>
      <Icon size={12} />
      {severity?.toUpperCase() || 'UNKNOWN'}
    </span>
  );
};

// ╔════════════════════════════════════════════════════════════════════════════╗
// ║                          MAIN COMPONENT                                     ║
// ╚════════════════════════════════════════════════════════════════════════════╝

const PIDVerificationV2 = () => {
  // ── State Management ────────────────────────────────────────────────────────
  const [selectedFile, setSelectedFile] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [processing, setProcessing] = useState(false);
  const [currentDoc, setCurrentDoc] = useState(null);
  const [currentPageIndex, setCurrentPageIndex] = useState(0);
  const [findings, setFindings] = useState([]);
  const [zoom, setZoom] = useState(DEFAULT_ZOOM_LEVEL);
  const [filterText, setFilterText] = useState('');
  const [selectedSeverities, setSelectedSeverities] = useState(new Set(['critical', 'high', 'medium', 'low']));
  
  const canvasRef = useRef(null);
  const fileInputRef = useRef(null);

  // ── Upload Handler ──────────────────────────────────────────────────────────
  const handleFileSelect = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      setSelectedFile(file);
    }
  };

  const handleUpload = async () => {
    if (!selectedFile) return;

    setUploading(true);
    const formData = new FormData();
    formData.append('file', selectedFile);

    try {
      const res = await axios.post(`${API_PREFIX}/upload/`, formData, {
        headers: { ...authHeader(), 'Content-Type': 'multipart/form-data' },
      });
      
      const docId = res.data.document_id || res.data.id;
      setCurrentDoc({ ...res.data, document_id: docId });
      setCurrentPageIndex(0);
      
      // Start processing
      setProcessing(true);
      await pollProcessingStatus(docId);
    } catch (err) {
      console.error('Upload failed:', err);
      alert('Upload failed: ' + (err.response?.data?.error || err.message));
    } finally {
      setUploading(false);
    }
  };

  // ── Poll Processing Status ──────────────────────────────────────────────────
  const pollProcessingStatus = async (docId) => {
    let attempts = 0;
    const maxAttempts = 60;
    
    const poll = async () => {
      try {
        const res = await axios.get(`${API_PREFIX}/${docId}/`, { headers: authHeader() });
        const status = res.data.status;
        
        if (status === 'completed') {
          setCurrentDoc(res.data);
          loadFindings(res.data);
          setProcessing(false);
          return;
        } else if (status === 'failed') {
          alert('Processing failed: ' + (res.data.error_message || 'Unknown error'));
          setProcessing(false);
          return;
        }
        
        attempts++;
        if (attempts < maxAttempts) {
          setTimeout(poll, 2000); // Poll every 2 seconds
        } else {
          alert('Processing timeout - please refresh to check status');
          setProcessing(false);
        }
      } catch (err) {
        console.error('Polling error:', err);
        setProcessing(false);
      }
    };
    
    poll();
  };

  // ── Load Findings ───────────────────────────────────────────────────────────
  const loadFindings = (doc) => {
    const allFindings = [];
    const metadata = doc.metadata || {};
    
    // Extract findings from verification_results
    if (doc.verification_results && Array.isArray(doc.verification_results.findings)) {
      doc.verification_results.findings.forEach(f => {
        if (!HIDDEN_SEVERITIES.has(f.severity?.toLowerCase())) {
          allFindings.push({
            id: f.id || `finding-${allFindings.length}`,
            severity: f.severity || 'info',
            category: f.category || 'general',
            description: f.description || f.message || 'No description',
            tag: f.tag || '-',
            page: f.page || 1,
          });
        }
      });
    }
    
    setFindings(allFindings);
  };

  // ── Image Loading ───────────────────────────────────────────────────────────
  useEffect(() => {
    if (!currentDoc || !canvasRef.current) return;
    
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    const docId = currentDoc.document_id || currentDoc.id;
    
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.src = `${API_PREFIX}/drawing-image/${docId}/${currentPageIndex}/`;
    
    img.onload = () => {
      canvas.width = img.width;
      canvas.height = img.height;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0);
    };
    
    img.onerror = () => {
      console.error('Failed to load drawing image');
    };
  }, [currentDoc, currentPageIndex]);

  // ── Zoom Controls ───────────────────────────────────────────────────────────
  const handleZoomIn = () => setZoom(prev => Math.min(prev + ZOOM_STEP, MAX_ZOOM));
  const handleZoomOut = () => setZoom(prev => Math.max(prev - ZOOM_STEP, MIN_ZOOM));
  const handleResetZoom = () => setZoom(DEFAULT_ZOOM_LEVEL);

  // ── Page Navigation ─────────────────────────────────────────────────────────
  const totalPages = currentDoc?.total_pages || 1;
  const canGoPrev = currentPageIndex > 0;
  const canGoNext = currentPageIndex < totalPages - 1;

  const handlePrevPage = () => {
    if (canGoPrev) setCurrentPageIndex(prev => prev - 1);
  };

  const handleNextPage = () => {
    if (canGoNext) setCurrentPageIndex(prev => prev + 1);
  };

  // ── Filter Findings ─────────────────────────────────────────────────────────
  const filteredFindings = findings.filter(f => {
    if (!selectedSeverities.has(f.severity?.toLowerCase())) return false;
    if (filterText && !f.description?.toLowerCase().includes(filterText.toLowerCase()) && !f.tag?.toLowerCase().includes(filterText.toLowerCase())) return false;
    return true;
  });

  const toggleSeverity = (sev) => {
    setSelectedSeverities(prev => {
      const newSet = new Set(prev);
      if (newSet.has(sev)) {
        newSet.delete(sev);
      } else {
        newSet.add(sev);
      }
      return newSet;
    });
  };

  // ── Export to Excel ─────────────────────────────────────────────────────────
  const handleExport = async () => {
    if (!currentDoc) return;
    
    try {
      const docId = currentDoc.document_id || currentDoc.id;
      const res = await axios.get(`${API_PREFIX}/${docId}/export-excel/`, {
        headers: authHeader(),
        responseType: 'blob',
      });
      
      const url = window.URL.createObjectURL(new Blob([res.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `pid-verification-${docId}.xlsx`);
      document.body.appendChild(link);
      link.click();
      link.remove();
    } catch (err) {
      console.error('Export failed:', err);
      alert('Export failed');
    }
  };

  // ╔════════════════════════════════════════════════════════════════════════════╗
  // ║                            RENDER                                           ║
  // ╚════════════════════════════════════════════════════════════════════════════╝

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50">
      {/* Header */}
      <div className="bg-white border-b border-gray-200 shadow-sm">
        <div className="max-w-[1920px] mx-auto px-6 py-4">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-2xl font-bold text-gray-900">P&ID Verification V2</h1>
              <p className="text-sm text-gray-500 mt-0.5">Clean & Focused Design</p>
            </div>
            
            {currentDoc && (
              <button
                onClick={handleExport}
                className="flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors"
              >
                <Download size={16} />
                Export Excel
              </button>
            )}
          </div>
        </div>
      </div>

      {/* Main Content */}
      <div className="max-w-[1920px] mx-auto p-6">
        {!currentDoc ? (
          // ── Upload Section ────────────────────────────────────────────────────
          <div className="max-w-2xl mx-auto">
            <div className="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
              <div className="text-center mb-6">
                <div className="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <UploadIcon className="text-indigo-600" size={32} />
                </div>
                <h2 className="text-xl font-semibold text-gray-900">Upload P&ID Drawing</h2>
                <p className="text-sm text-gray-500 mt-2">Select a PDF file to verify</p>
              </div>

              <input
                ref={fileInputRef}
                type="file"
                accept=".pdf"
                onChange={handleFileSelect}
                className="hidden"
              />

              <button
                onClick={() => fileInputRef.current?.click()}
                className="w-full border-2 border-dashed border-gray-300 rounded-lg p-8 hover:border-indigo-400 hover:bg-indigo-50 transition-all"
              >
                <FileText className="mx-auto text-gray-400 mb-2" size={48} />
                <p className="text-sm text-gray-600">
                  {selectedFile ? selectedFile.name : 'Click to select file'}
                </p>
              </button>

              {selectedFile && (
                <button
                  onClick={handleUpload}
                  disabled={uploading}
                  className="w-full mt-4 px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:bg-gray-300 disabled:cursor-not-allowed transition-colors font-medium"
                >
                  {uploading ? (
                    <span className="flex items-center justify-center gap-2">
                      <Loader className="animate-spin" size={20} />
                      Uploading...
                    </span>
                  ) : (
                    'Upload & Process'
                  )}
                </button>
              )}
            </div>
          </div>
        ) : (
          // ── Split Layout: Drawing + Findings ──────────────────────────────────
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 h-[calc(100vh-180px)]">
            {/* Left Panel: Drawing Viewer */}
            <div className="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden flex flex-col">
              {/* Drawing Controls */}
              <div className="bg-gray-50 border-b border-gray-200 px-4 py-3 flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <button
                    onClick={handlePrevPage}
                    disabled={!canGoPrev}
                    className="p-2 rounded hover:bg-gray-200 disabled:opacity-30 disabled:cursor-not-allowed"
                  >
                    <ChevronLeft size={20} />
                  </button>
                  <span className="text-sm font-medium text-gray-700 min-w-[80px] text-center">
                    Page {currentPageIndex + 1} / {totalPages}
                  </span>
                  <button
                    onClick={handleNextPage}
                    disabled={!canGoNext}
                    className="p-2 rounded hover:bg-gray-200 disabled:opacity-30 disabled:cursor-not-allowed"
                  >
                    <ChevronRight size={20} />
                  </button>
                </div>

                <div className="flex items-center gap-2">
                  <button onClick={handleZoomOut} className="p-2 rounded hover:bg-gray-200">
                    <ZoomOut size={20} />
                  </button>
                  <span className="text-sm font-medium text-gray-700 min-w-[60px] text-center">
                    {Math.round(zoom * 100)}%
                  </span>
                  <button onClick={handleZoomIn} className="p-2 rounded hover:bg-gray-200">
                    <ZoomIn size={20} />
                  </button>
                  <button onClick={handleResetZoom} className="p-2 rounded hover:bg-gray-200">
                    <RotateCw size={20} />
                  </button>
                </div>
              </div>

              {/* Drawing Canvas */}
              <div className="flex-1 overflow-auto bg-gray-100 p-4">
                {processing ? (
                  <div className="flex flex-col items-center justify-center h-full">
                    <Loader className="animate-spin text-indigo-600 mb-4" size={48} />
                    <p className="text-gray-600 font-medium">Processing drawing...</p>
                    <p className="text-sm text-gray-500 mt-2">This may take a few minutes</p>
                  </div>
                ) : (
                  <div className="flex items-center justify-center min-h-full">
                    <canvas
                      ref={canvasRef}
                      style={{ transform: `scale(${zoom})`, transformOrigin: 'center' }}
                      className="max-w-full shadow-lg"
                    />
                  </div>
                )}
              </div>
            </div>

            {/* Right Panel: Findings Table */}
            <div className="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden flex flex-col">
              {/* Findings Header */}
              <div className="bg-gray-50 border-b border-gray-200 px-4 py-3">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="text-lg font-semibold text-gray-900">
                    Findings ({filteredFindings.length})
                  </h3>
                  <button
                    onClick={() => { setCurrentDoc(null); setSelectedFile(null); setFindings([]); }}
                    className="text-sm text-indigo-600 hover:text-indigo-700 font-medium"
                  >
                    New Upload
                  </button>
                </div>

                {/* Search & Filters */}
                <div className="space-y-2">
                  <div className="relative">
                    <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" size={16} />
                    <input
                      type="text"
                      placeholder="Search findings..."
                      value={filterText}
                      onChange={(e) => setFilterText(e.target.value)}
                      className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                    />
                  </div>

                  <div className="flex gap-2 flex-wrap">
                    {['critical', 'high', 'medium', 'low'].map(sev => (
                      <button
                        key={sev}
                        onClick={() => toggleSeverity(sev)}
                        className={`px-3 py-1 rounded text-xs font-medium transition-all ${
                          selectedSeverities.has(sev)
                            ? 'bg-indigo-100 text-indigo-700 border border-indigo-300'
                            : 'bg-gray-100 text-gray-500 border border-gray-200'
                        }`}
                      >
                        {selectedSeverities.has(sev) ? <Eye size={12} className="inline mr-1" /> : <EyeOff size={12} className="inline mr-1" />}
                        {sev.toUpperCase()}
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              {/* Findings List */}
              <div className="flex-1 overflow-auto">
                {filteredFindings.length === 0 ? (
                  <div className="flex flex-col items-center justify-center h-full text-gray-400">
                    <CheckCircle size={48} className="mb-2" />
                    <p className="text-sm">No findings match your filters</p>
                  </div>
                ) : (
                  <div className="divide-y divide-gray-200">
                    {filteredFindings.map((finding, idx) => (
                      <div key={finding.id || idx} className="p-4 hover:bg-gray-50 transition-colors">
                        <div className="flex items-start justify-between gap-3 mb-2">
                          {getSeverityBadge(finding.severity)}
                          <span className="text-xs text-gray-500">Page {finding.page}</span>
                        </div>
                        <p className="text-sm text-gray-900 font-medium mb-1">{finding.description}</p>
                        <div className="flex items-center gap-3 text-xs text-gray-500">
                          <span className="bg-gray-100 px-2 py-0.5 rounded">{finding.category}</span>
                          {finding.tag && finding.tag !== '-' && (
                            <span className="bg-blue-50 text-blue-700 px-2 py-0.5 rounded">Tag: {finding.tag}</span>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default PIDVerificationV2;
